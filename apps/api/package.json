		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tagalong/config": "workspace:*",
		"@cloudflare/vitest-plugin": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}

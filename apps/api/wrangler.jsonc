{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tagalong-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],

	// Custom Domain on the averrow.com zone, like bvom-api.averrow.com.
	// Cloudflare creates the DNS record and issues the edge certificate itself.
	// It cannot be created over an existing DNS record for this hostname.
	// tagalong.averrow.com is left free for a web app.
	"routes": [{ "pattern": "tagalong-api.averrow.com", "custom_domain": true }],

	// Production traffic arrives only on the Custom Domain above.
	"workers_dev": false,
	"preview_urls": false,

	"observability": { "enabled": true, "head_sampling_rate": 1 },

	// Non-secret configuration only. Secrets go through `wrangler secret put`
	// and never appear in this file.
	"vars": {
		"ENVIRONMENT": "production",
		// Overwritten at deploy time with --var GIT_SHA:<sha>; /health serves it.
		"GIT_SHA": "dev",
		// Booking.com Demand API. Point at https://demandapi-sandbox.booking.com/3.1
		// to try the sandbox.
		"BOOKING_API_BASE": "https://demandapi.booking.com/3.1",
		// Sender for price-drop emails; the domain must be verified in Resend.
		"ALERT_FROM_EMAIL": "Budgetrip <alerts@averrow.com>",
	},

	// Scheduled price checks for saved trips (phase 3). Every 6 hours at :23.
	"triggers": { "crons": ["23 */6 * * *"] },

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tagalong-db",
			"database_id": "d31489d3-930e-4fed-b961-239f3f1aaebc",
			// Migrations live at the repo root so CI, tests and deploy all read
			// one directory. Resolved relative to this config file.
			"migrations_dir": "../../migrations",
		},
	],
}

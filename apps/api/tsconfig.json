{
	"extends": "@tagalong/config/tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		// Runtime types come from worker-configuration.d.ts, generated by
		// `wrangler types` from wrangler.jsonc.
		"types": ["@cloudflare/vitest-plugin/types"]
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}

{
	"name": "@tagalong/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && vite build",
		"lint": "tsc --noEmit -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"deploy": "wrangler deploy",
		"cap:sync": "pnpm build && cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android"
	},
	"dependencies": {
		"@capacitor-firebase/messaging": "catalog:",
		"@capacitor/app": "catalog:",
		"@capacitor/browser": "catalog:",
		"@capacitor/core": "catalog:",
		"@tagalong/shared": "workspace:*",
		"capacitor-secure-storage-plugin": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@capacitor/android": "catalog:",
		"@capacitor/cli": "catalog:",
		"@capacitor/ios": "catalog:",
		"@tagalong/config": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}

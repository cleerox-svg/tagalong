{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalDependencies": [
		"pnpm-workspace.yaml",
		"pnpm-lock.yaml",
		".nvmrc",
		"migrations/**",
		"packages/config/**"
	],
	"globalEnv": ["NODE_ENV", "CI"],
	"tasks": {
		"lint": { "outputs": [] },
		"typecheck": { "outputs": [] },
		"test": { "outputs": [] },
		"build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
		"dev": { "cache": false, "persistent": true }
	}
}
